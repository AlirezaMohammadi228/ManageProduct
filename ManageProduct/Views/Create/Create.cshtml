<div class="container mt-5">
    <div class="p-4 bg-light border rounded">
        <form>
            <div class="mb-3">
                <label for="username" class="form-label">نام کاربری</label>
                <input type="text" class="form-control" placeholder="Product Name">
            </div>

            <div class="mb-3">
                <label for="price" class="form-label">رمز عبور</label>
                <input type="number" class="form-control" id="price" placeholder="Product Price">
            </div>
            <div class="mb-3">
                <label for="category" class="form-label">Please Select the type</label>
                <select class="form-select" id="category" required>
                    
                    <option value="1">Clothes</option>
                    <option value="2">Detergent</option>
                    <option value="3">Food</option>
                </select>
            </div>
            <div class="mb-3">
                <label for="price" class="form-label">رمز عبور</label>
                <input type="number" class="form-control" id="quantity" placeholder="Product Price">
            </div>

            <button type="submit" class="btn btn-primary">Send</button>
        </form>
    </div>
</div>