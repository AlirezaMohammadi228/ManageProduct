@model Product
@{
    ViewData["title"] = "Update";
}

<form asp-controller="Product" asp-action="Update" asp-route-id="@Model.Id" method="post">
    <div class="mb-3">
        <label for="Name" class="form-label">Name</label>
        <input type="text" name="Name" class="form-control" id="Name" aria-describedby="emailHelp" value="@Model.Name">
    </div>
    <div class="mb-3">
        <label for="Price" class="form-label">Price</label>
        <input type="number" name="Price" class="form-control" id="Price" value="@Model.Price">
    </div>
    <div class="mb-3">
        <label for="Quantity" class="form-label">Quantity</label>
        <input type="number" name="Quantity" class="form-control" id="Quantity" value="@Model.Quantity">
    </div>
    <div class="mb-3">
        <label for="productType" class="form-label">Product Type</label>
        <select name="ProductType" id="ProductType" class="form-select">
            <option value="0" selected="@(Model.productType == 0)">None</option>
            <option value="1" selected="@(Model.productType == (ProductType)1)">Clothes</option>
            <option value="2" selected="@(Model.productType == (ProductType)2)">Detergent</option>
            <option value="3" selected="@(Model.productType == (ProductType)3)">Food</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>
