@{
    ViewData["Title"] = "Home Page";
}

<form action="/" method="post">
    <table class="">
        <thead>
            <tr>
                <th>ردیف</th>
                <th>نام</th>
                <th>نوع</th>
                <th>قیمت</th>
                <th>تعداد</th>
            </tr>
        </thead>
        <tbody>
            @{
                int rowNumber = 1;
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@rowNumber</td>
                    <td>@item.Name</td>
                    <td>@item.Type</td>
                    <td>@item.Price.ToString("N0") تومان</td>
                    <td>@item.Quantity</td>
                </tr>
                rowNumber++;
            }
        </tbody>
    </table>
</form>

