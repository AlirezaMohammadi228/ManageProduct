@model ProductRepository
@{
}

<a asp-action="Create">Create</a>
<table class="table">
    <tr>
        <th>Name</th>
        <th>Price</th>
        <th>Quantity</th>
        <th>Type</th>
        <th>Action</th>
    </tr>
    @foreach (var item in Model.GetAll())
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Price</td>
            <td>@item.Quantity</td>
            <td>@item.productType</td>
            <td>
                <a asp-action="Update" asp-route-Id="@item.Id">Update</a>
                <a asp-action="Delete" asp-route-Id="@item.Id">Delete</a>
            </td>
        </tr>
    }
</table>
<p>Total Price: @Model.TotalValue()</p>

