@model List<Product>
@{
}

<form asp-controller="Product" asp-action="Index" method="post">
    <div class="mb-3">
        <label for="productType" class="form-label">Product Type</label>
        <select name="productType" id="productType" class="form-select">

            <option value="0">None</option>
            <option value="1">Clothes</option>
            <option value="2">Detergent</option>
            <option value="3">Food</option>
        </select>
    </div>
    <div class="mb-3">
        <label for="Name" class="form-label">Name</label>
        <input type="text" name="st" class="form-control" id="st">
    </div>
    <button type="submit" class="btn btn-primary">Apply Filter</button>
</form>
<a asp-action="Create">Create</a>
<table class="table">
    <tr>
        <th>Name</th>
        <th>Price</th>
        <th>Quantity</th>
        <th>Type</th>
        <th>Action</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Price</td>
            <td>@item.Quantity</td>
            <td>@item.productType</td>
            <td>
                <a asp-action="Update" asp-route-Id="@item.Id">Update</a>
                <a asp-action="Delete" asp-route-Id="@item.Id">Delete</a>
            </td>
        </tr>
    }
</table>
<p>Total Price: @Model.Sum(x => x.Quantity * x.Price)</p>

